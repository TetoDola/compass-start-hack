# Optional. The demo runs without these keys using public news and dated holdings.
# Copy to .env.local, set only what you have, then restart npm run dev.
# These are server-only variables; never prefix a secret with VITE_.
FMP_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Start the local OpenBB API with: docker compose up -d --build
# Then set OPENBB_BASE_URL=http://127.0.0.1:6900/api/v1
OPENBB_BASE_URL=
# Example: http://127.0.0.1:6900/api/v1
OPENBB_NEWS_PROVIDER=yfinance
# Optional explicit ticker overrides. The bundled yfinance connector accepts ISINs directly.
# Example for Yahoo Finance: {"US0378331005":"AAPL"}
OPENBB_SYMBOLS={}

# Local demo alternative: installed Codex CLI signed in with ChatGPT.
# AI_PROVIDER=codex
# CODEX_MODEL= (optional; otherwise uses your Codex default)

# CODEX_BIN=/path/to/current/codex (optional; defaults to codex on PATH)
